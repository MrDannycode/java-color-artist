<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<VBox id="menuRoot" alignment="TOP_CENTER" spacing="0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.colorartist.MenuController">

    <!-- Header -->
    <VBox alignment="CENTER" spacing="8">
        <padding>
            <Insets top="48" bottom="12" left="24" right="24"/>
        </padding>
        <Label id="titleLabel" text="🎨 Color Artist"/>
        <Label id="subtitleLabel" text="Choose a level and start coloring!"/>
    </VBox>

    <!-- Level Grid -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="24" bottom="24" left="48" right="48"/>
        </padding>
        <FlowPane fx:id="levelsGrid" hgap="24" vgap="24" alignment="CENTER">
            <padding>
                <Insets top="12" bottom="24" left="12" right="12"/>
            </padding>
        </FlowPane>
    </ScrollPane>
</VBox>
